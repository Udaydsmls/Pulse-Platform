charts/*.tgz

# ─── Generated protobuf code ──────────────────────────────────────────────────
# Produced by `make proto` from the .proto files in proto/, which are the real
# source of truth. Not committed, so a stale checked-in copy can't drift from
# the contract.
services/*/gen/
